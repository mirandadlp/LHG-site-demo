# Copy to .env.local for local development, and set the same variables in your hosting provider.

# Public URL of the site (used for canonical URLs, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search engines are blocked unless this is "true". Set it ONLY on the live production deployment.
ALLOW_INDEXING=false

# --- Enquiry form delivery (configure ONE option) ---------------------------
# Until one is set, the form tells visitors it is not yet connected and shows the phone/email instead.

# Option A: POST each enquiry as JSON to a webhook (Zapier, Make, Power Automate, a CRM, etc.)
CONTACT_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" so the receiver can verify the request
CONTACT_WEBHOOK_SECRET=

# Option B: send each enquiry by email through Resend (https://resend.com)
RESEND_API_KEY=
# Comma-separated list of recipient addresses
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend
CONTACT_FROM_EMAIL=

# --- Analytics (optional) ----------------------------------------------------
# Google Analytics 4 measurement ID. Only loads after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
